# BYOK provider preset URLs — override the defaults baked into the build
# All variables are optional; the hardcoded fallbacks are used when unset.

VITE_BYOK_ANTHROPIC_URL=https://api.anthropic.com
VITE_BYOK_ANTHROPIC_MODEL=claude-sonnet-4-6

VITE_BYOK_OPENAI_URL=https://api.openai.com
VITE_BYOK_OPENAI_MODEL=gpt-4o

VITE_BYOK_GEMINI_URL=https://generativelanguage.googleapis.com
VITE_BYOK_GEMINI_MODEL=gemini-2.5-flash

VITE_BYOK_GROQ_URL=https://api.groq.com/openai
VITE_BYOK_GROQ_MODEL=llama-3.3-70b-versatile

VITE_BYOK_MISTRAL_URL=https://api.mistral.ai
VITE_BYOK_MISTRAL_MODEL=mistral-large-latest

VITE_BYOK_TOGETHER_URL=https://api.together.xyz
VITE_BYOK_TOGETHER_MODEL=meta-llama/Llama-3-70b-chat-hf

VITE_BYOK_PERPLEXITY_URL=https://api.perplexity.ai
VITE_BYOK_PERPLEXITY_MODEL=llama-3.1-sonar-large-128k-online
