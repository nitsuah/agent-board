CONTENT_GEN_PORT=3200

# Pexels API key for stock footage (https://www.pexels.com/api/)
PEXELS_API_KEY=your_pexels_key_here

# Optional LLM keys (only needed if not using a pre-written script)
# GEMINI_API_KEY=your_gemini_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Path to the MoneyPrinterTurbo docker-compose.yml
# Default resolves to tools/content-gen/MoneyPrinterTurbo/docker-compose.yml
# MONEYPRINTERTURBO_COMPOSE=C:/Users/ajhar/code/agent-board/tools/content-gen/MoneyPrinterTurbo/docker-compose.yml

# MoneyPrinterTurbo API and UI URLs (running on the host)
MPT_API_URL=http://localhost:8080
MPT_UI_URL=http://localhost:8501
