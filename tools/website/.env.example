WEBSITE_PORT=3201

# Where generated client files are saved.
# In Docker this maps to /app/output (the named volume).
# Leave blank to use the default (tools/website/output/ on host, /app/output in container).
WEBSITE_OUTPUT_DIR=

# Netlify auth token — replaces `netlify login` when running in Docker.
# Get yours at: https://app.netlify.com/user/applications#personal-access-tokens
NETLIFY_AUTH_TOKEN=

# Discovery APIs (Yelp preferred — free 500 calls/day)
YELP_API_KEY=
GOOGLE_PLACES_API_KEY=

# Your agency info (shown in pitch decks and invoices)
YOUR_NAME=
YOUR_COMPANY=Your Web Agency
YOUR_EMAIL=
YOUR_PHONE=
PRICE_SETUP=500
PRICE_MONTHLY=50
